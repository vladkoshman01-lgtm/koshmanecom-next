{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "regex": "^[^.]*$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/opengraph-image*",
          "headers": [
            {
              "key": "Content-Type",
              "value": "image/png"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.@(html|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|svg|mp4|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/etsy-profit-calculator",
          "destination": "/en/etsy-profit-calculator",
          "type": 301
        },
        {
          "source": "/etsy-pricing-calculator",
          "destination": "/en/etsy-pricing-calculator",
          "type": 301
        },
        {
          "source": "/etsy-vs-amazon-vs-shopify",
          "destination": "/en/etsy-vs-amazon-vs-shopify",
          "type": 301
        },
        {
          "source": "/tools/etsy-finance-dashboard",
          "destination": "/tools",
          "type": 301
        }
      ]
    },
    {
      "target": "staging",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "regex": "^[^.]*$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/opengraph-image*",
          "headers": [
            {
              "key": "Content-Type",
              "value": "image/png"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.@(html|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|svg|mp4|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/etsy-profit-calculator",
          "destination": "/en/etsy-profit-calculator",
          "type": 301
        },
        {
          "source": "/etsy-pricing-calculator",
          "destination": "/en/etsy-pricing-calculator",
          "type": 301
        },
        {
          "source": "/etsy-vs-amazon-vs-shopify",
          "destination": "/en/etsy-vs-amazon-vs-shopify",
          "type": 301
        },
        {
          "source": "/tools/etsy-finance-dashboard",
          "destination": "/tools",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
