rules_version = '2';

// Браузер до бази не ходить узагалі: кабінет, форма заявок і ліміти працюють
// через Cloud Functions (admin SDK правила обходить). Тому тут заборонено все.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
